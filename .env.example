# Discord webhook to post into (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Your Discord user ID, so alerts @-ping you.
# Enable Settings -> Advanced -> Developer Mode, then right-click your name -> Copy User ID
DISCORD_USER_ID=123456789012345678

# Optional: ping a role instead of / as well as a user
# DISCORD_ROLE_ID=123456789012345678

# Optional overrides for config.json
# ZIP=75126
# RADIUS_MILES=50
# POLL_SECONDS=20

# Optional: route traffic through a proxy. Needed only if a cloud host's
# datacenter IP gets blocked by AWS WAF. Format: http://user:pass@host:port
# PROXY_URL=

# Optional: where to keep seen.json (containers set this to a mounted volume)
# DATA_DIR=/data
